{
  "name": "rayegan",
  "version": "0.1.0",
  "description": "One OpenAI-compatible endpoint on top of every free LLM API tier: the smartest model with quota left answers, then the next. Keyless providers first, HTTP and SOCKS5 proxy support, built for developers in Iran.",
