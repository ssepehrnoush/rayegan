    "llm",
    "free-llm-api",
    "openai-compatible",
    "llm-router",
    "llm-gateway",
    "fallback",
    "rate-limit",
    "groq",
    "gemini",
    "openrouter",
    "cerebras",
    "proxy",
    "socks5",
    "iran",
    "persian"
  ],
  "license": "MIT",
  "author": "ssepehrnoush",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "rayegan": "./src/cli.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
